---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Leonardo | Portafolio Profesional", 
	description = "Portafolio profesional de Leonardo, Desarrollador Full Stack. Conoce mis proyectos, habilidades y experiencia en el desarrollo de aplicaciones web." 
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="desarrollador web, full stack, react, astro, tailwind, typescript, node.js, portafolio, madrid" />
		<meta name="author" content="Leonardo" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body class="relative min-h-screen bg-black text-[#f3f4f6] antialiased">
		<!-- Main content grid structure -->
		<div class="relative z-10 flex min-h-screen flex-col">
			<slot />
		</div>
	</body>
</html>
