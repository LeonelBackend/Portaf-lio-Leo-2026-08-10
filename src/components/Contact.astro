---
import { portfolioData } from '../data/portfolio';

const { email, location, socials } = portfolioData;
---

<section id="contacto" class="relative py-24 px-4 md:px-8 bg-slate-950/20">
  <div class="mx-auto max-w-6xl z-10 w-full">
    
    <!-- Section Header -->
    <div class="text-center space-y-4 mb-16">
      <h2 class="text-xs font-bold tracking-widest text-zinc-400 uppercase">Contacto</h2>
      <p class="text-3xl font-extrabold text-white sm:text-4xl">¿Tienes un Proyecto en Mente?</p>
      <p class="text-slate-400 max-w-lg mx-auto">Ponte en contacto conmigo para conversar sobre colaboraciones, oportunidades de empleo o simplemente saludar.</p>
    </div>

    <!-- Contact Layout Grid -->
    <div class="grid gap-12 md:grid-cols-12 items-start">
      
      <!-- Left Column: Info & Action -->
      <div class="md:col-span-5 flex flex-col space-y-8">
        <div class="rounded-2xl glass p-6 border-slate-800/80 space-y-6">
          <h3 class="text-xl font-bold text-white tracking-wide">Información de Contacto</h3>
          
          <div class="space-y-4 text-slate-300">
            <!-- Email Item with Copy Action -->
            <div class="flex items-center space-x-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-zinc-900 text-zinc-300 border border-zinc-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-xs text-slate-500 font-semibold uppercase">Email</p>
                <button 
                  id="copy-email-btn"
                  class="group flex items-center space-x-1.5 text-sm font-medium hover:text-white transition-colors truncate"
                  data-email={email}
                >
                  <span class="truncate">{email}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Location Item -->
            <div class="flex items-center space-x-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-zinc-900 text-zinc-300 border border-zinc-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-slate-500 font-semibold uppercase">Ubicación</p>
                <p class="text-sm font-medium">{location}</p>
              </div>
            </div>
          </div>
          
          <!-- Social Link Icons in Card -->
          <div class="border-t border-slate-800/80 pt-6">
            <p class="text-xs text-slate-500 font-semibold uppercase mb-3">Redes Sociales</p>
            <div class="flex gap-3">
              {socials.map((social) => (
                <a 
                  href={social.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-800/80 bg-slate-950/20 text-slate-400 hover:text-white hover:border-slate-700 hover:bg-slate-900/40 transition-all"
                  aria-label={social.platform}
                >
                  {social.icon === 'github' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 fill-current" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                  )}
                  {social.icon === 'linkedin' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 fill-current" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  )}
                  {social.icon === 'email' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="md:col-span-7">
        <form 
          id="contact-form"
          class="rounded-2xl glass p-8 border-slate-800/80 space-y-6 flex flex-col"
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <!-- Name Input -->
            <div class="flex flex-col space-y-2">
              <label for="form-name" class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Nombre</label>
              <input 
                type="text" 
                id="form-name" 
                name="name" 
                required 
                placeholder="Tu nombre" 
                class="rounded-xl border border-slate-800/80 bg-slate-950/30 px-4 py-3 text-sm text-white placeholder-slate-600 outline-none transition-all focus:border-white focus:bg-slate-950/60 focus:shadow-md focus:shadow-white/5"
              />
            </div>
            <!-- Email Input -->
            <div class="flex flex-col space-y-2">
              <label for="form-email" class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Email</label>
              <input 
                type="email" 
                id="form-email" 
                name="email" 
                required 
                placeholder="tu@email.com" 
                class="rounded-xl border border-slate-800/80 bg-slate-950/30 px-4 py-3 text-sm text-white placeholder-slate-600 outline-none transition-all focus:border-white focus:bg-slate-950/60 focus:shadow-md focus:shadow-white/5"
              />
            </div>
          </div>

          <!-- Message Textarea -->
          <div class="flex flex-col space-y-2">
            <label for="form-message" class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Mensaje</label>
            <textarea 
              id="form-message" 
              name="message" 
              required 
              rows="5" 
              placeholder="Hola Leo, me gustaría hablar contigo sobre..." 
              class="rounded-xl border border-slate-800/80 bg-slate-950/30 px-4 py-3 text-sm text-white placeholder-slate-600 outline-none resize-none transition-all focus:border-white focus:bg-slate-950/60 focus:shadow-md focus:shadow-white/5"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            class="group relative flex items-center justify-center gap-2 overflow-hidden rounded-xl bg-white px-6 py-3.5 text-sm font-semibold text-black shadow-lg shadow-white/5 transition-all hover:bg-zinc-200 hover:-translate-y-0.5"
          >
            <span>Enviar Mensaje</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
          
          <p id="form-feedback" class="text-center text-xs font-medium opacity-0 transition-opacity duration-300"></p>
        </form>
      </div>

    </div>
  </div>
</section>

<!-- Inline script for dynamic interactivity -->
<script>
  // Copy email logic
  const copyBtn = document.getElementById('copy-email-btn');
  copyBtn?.addEventListener('click', () => {
    const emailStr = copyBtn.getAttribute('data-email') || '';
    navigator.clipboard.writeText(emailStr).then(() => {
      // Temporary tooltip visual success feedback
      const originalText = copyBtn.innerHTML;
      copyBtn.innerHTML = '<span>¡Copiado!</span>';
      copyBtn.style.color = '#34d399'; // Emerald text color
      setTimeout(() => {
        copyBtn.innerHTML = originalText;
        copyBtn.style.color = '';
      }, 2000);
    }).catch(err => {
      console.error('Error copying email: ', err);
    });
  });

  // Mock Form Submit logic
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const formFeedback = document.getElementById('form-feedback');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!formFeedback) return;
    
    // Simulate API call
    formFeedback.innerText = "¡Mensaje enviado con éxito! Me pondré en contacto contigo pronto.";
    formFeedback.className = "text-center text-xs font-medium text-emerald-400 opacity-100";
    contactForm.reset();

    setTimeout(() => {
      formFeedback.className = "text-center text-xs font-medium opacity-0 transition-opacity duration-300";
    }, 5000);
  });
</script>
