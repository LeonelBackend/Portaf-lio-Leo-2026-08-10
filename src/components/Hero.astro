---
import { portfolioData } from "../data/portfolio";

const { name, avatar, title, tagline, bio, cvUrl } = portfolioData;
---

<section
  id="inicio"
  class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 pt-24 md:px-8"
>
  <div
    class="mx-auto grid max-w-6xl gap-12 md:grid-cols-12 items-center z-10 w-full"
  >
    <!-- Hero Text (Left column) -->
    <div
      class="md:col-span-7 flex flex-col space-y-6 animate-fade-in-up text-left"
    >
      <div
        class="inline-flex items-center space-x-2 rounded-full border border-zinc-800 bg-zinc-900/60 px-4 py-1.5 text-sm font-medium text-zinc-300"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-100"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-green"
          ></span>
        </span>
        <span>Disponible para trabajar</span>
      </div>

      <h1
        class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl text-white"
      >
        Hola, soy <span class="text-gradient font-black">{name}</span>
      </h1>

      <h2 class="text-2xl font-bold text-slate-300 sm:text-3xl">
        {title}
      </h2>

      <p class="text-lg font-medium text-zinc-300 max-w-lg leading-relaxed">
        {tagline}
      </p>
      <p class="text-base text-zinc-400 max-w-lg leading-relaxed">
        {bio}
      </p>

      <!-- CTA Buttons & Socials -->
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a
          href="#proyectos"
          class="group relative flex items-center gap-2 overflow-hidden rounded-xl bg-white px-6 py-3.5 text-base font-semibold text-black transition-all hover:bg-zinc-200 hover:-translate-y-0.5 shadow-lg shadow-white/5"
        >
          Ver Proyectos
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 transition-transform group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a
          href="#contacto"
          class="rounded-xl border border-zinc-800 bg-zinc-900/30 px-6 py-3.5 text-base font-semibold text-zinc-300 hover:text-white transition-all hover:bg-zinc-900/80 hover:border-zinc-700"
        >
          Hablemos
        </a>

        {cvUrl && (
          <a
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 rounded-xl border border-zinc-800 bg-zinc-900/30 px-6 py-3.5 text-base font-semibold text-zinc-300 hover:text-white transition-all hover:bg-zinc-900/80 hover:border-zinc-700"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 text-zinc-400 group-hover:text-white transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              />
            </svg>
            Ver CV
          </a>
        )}

        <!-- Social Icons -->
        <div class="flex items-center gap-3 ml-2">
          {
            portfolioData.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-800/80 bg-slate-950/40 text-slate-400 hover:text-white hover:border-slate-700 hover:bg-slate-900/60 transition-all"
                aria-label={social.platform}
              >
                {social.icon === "github" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 fill-current"
                    viewBox="0 0 24 24"
                  >
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                    />
                  </svg>
                )}
                {social.icon === "linkedin" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 fill-current"
                    viewBox="0 0 24 24"
                  >
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                  </svg>
                )}
                {social.icon === "email" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 stroke-current fill-none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Hero Card Visualization (Right column) -->
    <div
      class="md:col-span-5 relative flex justify-center items-center h-[400px]"
    >
      <!-- Premium Floating Glass Card -->
      <div
        class="relative w-72 h-96 rounded-2xl glass p-6 shadow-2xl flex flex-col justify-between animate-float border-zinc-800"
      >
        <!-- Card header decoration -->
        <div class="flex items-center justify-center w-full mb-4">
          <span
            class="text-xs font-semibold text-slate-500 uppercase tracking-widest"
            >Tarjeta de perfil</span
          >
        </div>

        <!-- Card Center Avatar & Decorative Circles -->
        <div class="flex flex-col items-center my-auto space-y-4">
          <div
            id="avatar-container"
            class="relative flex h-48 w-48 items-center justify-center rounded-full bg-slate-900 border border-slate-700/80 overflow-hidden shadow-inner cursor-pointer transition-transform hover:scale-105"
            title="Haz clic para ver la foto ampliada"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-zinc-800 to-zinc-950"
            >
            </div>
            {
              avatar ? (
                <img
                  src={avatar}
                  alt={name}
                  class="relative z-10 h-full w-full object-cover rounded-full"
                />
              ) : (
                <svg
                  class="relative z-10 h-16 w-16 text-zinc-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  />
                </svg>
              )
            }
          </div>
          <div class="text-center">
            <h3 class="text-xl font-bold text-white tracking-wide">{name}</h3>
            <p
              class="text-xs font-semibold text-zinc-400 tracking-wider uppercase mt-1"
            >
              Full Stack Developer
            </p>
          </div>
        </div>

        <!-- Card stats or labels -->
        <div
          class="grid grid-cols-2 gap-4 border-t border-slate-800/80 pt-4 text-center"
        >
          <div>
            <span class="block text-xs font-medium text-slate-500 uppercase"
              >Habilidades</span
            >
            <span class="text-sm font-bold text-slate-300">14+ Tecs</span>
          </div>
          <div>
            <span class="block text-xs font-medium text-slate-500 uppercase"
              >Experiencia</span
            >
            <span class="text-sm font-bold text-slate-300">Proyectos</span>
          </div>
        </div>
      </div>

      <!-- Behind Card: Decorative Abstract Orb -->
      <div
        class="absolute -right-4 -bottom-4 w-48 h-48 rounded-full bg-zinc-900/10 blur-2xl -z-10 animate-pulse-slow"
      >
      </div>
      <div
        class="absolute -left-4 -top-4 w-40 h-40 rounded-full bg-zinc-900/10 blur-2xl -z-10 animate-pulse-slow"
        style="animation-delay: 3s;"
      >
      </div>
    </div>
  </div>
</section>

<!-- Photo Lightbox Modal -->
<div
  id="avatar-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 p-4"
>
  <div class="relative max-w-md w-full flex flex-col items-center">
    <!-- Close Button -->
    <button
      id="close-avatar-modal"
      class="absolute -top-12 right-0 text-white/80 hover:text-white p-2 text-sm font-semibold tracking-wider flex items-center space-x-1 cursor-pointer"
      aria-label="Cerrar vista ampliada"
    >
      <span>Cerrar</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <!-- Modal Fullsize Photo -->
    <img
      src={avatar || "/leo_leo.jpeg"}
      alt={name}
      class="w-72 h-72 sm:w-96 sm:h-96 object-cover rounded-2xl border border-zinc-700 shadow-2xl scale-95 transition-transform duration-300"
      id="modal-avatar-img"
    />
  </div>
</div>

<script>
  const avatarContainer = document.getElementById('avatar-container');
  const avatarModal = document.getElementById('avatar-modal');
  const closeModal = document.getElementById('close-avatar-modal');
  const modalImg = document.getElementById('modal-avatar-img');

  function openModal() {
    if (!avatarModal) return;
    avatarModal.classList.remove('opacity-0', 'pointer-events-none');
    avatarModal.classList.add('opacity-100', 'pointer-events-auto');
    if (modalImg) {
      modalImg.classList.remove('scale-95');
      modalImg.classList.add('scale-100');
    }
  }

  function hideModal() {
    if (!avatarModal) return;
    avatarModal.classList.add('opacity-0', 'pointer-events-none');
    avatarModal.classList.remove('opacity-100', 'pointer-events-auto');
    if (modalImg) {
      modalImg.classList.add('scale-95');
      modalImg.classList.remove('scale-100');
    }
  }

  avatarContainer?.addEventListener('click', openModal);
  closeModal?.addEventListener('click', hideModal);
  avatarModal?.addEventListener('click', (e) => {
    if (e.target === avatarModal) hideModal();
  });
</script>
