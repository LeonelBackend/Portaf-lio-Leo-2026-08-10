---
import { portfolioData } from '../data/portfolio';

const skills = portfolioData.skills;

// Separate skills by category
const frontendSkills = skills.filter(s => s.category === 'Frontend');
const backendSkills = skills.filter(s => s.category === 'Backend');
const toolSkills = skills.filter(s => s.category === 'Herramientas');

const categories = [
  { 
    title: "Frontend", 
    data: frontendSkills, 
    iconColor: "text-emerald-400",
    iconType: "code"
  },
  { 
    title: "Backend", 
    data: backendSkills, 
    iconColor: "text-cyan-400",
    iconType: "database"
  },
  { 
    title: "Herramientas", 
    data: toolSkills, 
    iconColor: "text-purple-400",
    iconType: "wrench"
  }
];
---

<section id="habilidades" class="relative py-20 px-4 md:px-8">
  <div class="mx-auto max-w-6xl z-10 w-full">
    
    <!-- Section Header -->
    <div class="text-left space-y-2 mb-8">
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl tracking-tight">
        Stack Tecnológico
      </h2>
      <p class="text-base text-zinc-400">
        Herramientas y tecnologías que manejo cotidianamente
      </p>
    </div>

    <!-- Divider Line -->
    <div class="w-full border-b border-zinc-800/80 mb-10"></div>

    <!-- Categories Grid -->
    <div class="grid gap-6 md:grid-cols-3">
      {categories.map((category) => (
        <div class="rounded-2xl bg-[#0d0d0f] p-6 border border-zinc-800/80 flex flex-col space-y-6">
          
          <!-- Category Header with Icon -->
          <div class="flex items-center space-x-3">
            {category.iconType === 'code' && (
              <span class={`font-mono text-xl font-bold ${category.iconColor}`}>
                &lt;/&gt;
              </span>
            )}
            {category.iconType === 'database' && (
              <svg xmlns="http://www.w3.org/2000/svg" class={`h-6 w-6 ${category.iconColor}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21 3.582 4 8 4s8-1.79 8-4" />
              </svg>
            )}
            {category.iconType === 'wrench' && (
              <svg xmlns="http://www.w3.org/2000/svg" class={`h-6 w-6 ${category.iconColor}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            )}
            <h3 class="text-xl font-bold text-white tracking-wide">
              {category.title}
            </h3>
          </div>
          
          <!-- Technology Tag Pills -->
          <div class="flex flex-wrap gap-2.5 pt-2">
            {category.data.map((skill) => (
              <span class="rounded-xl bg-zinc-800/60 border border-zinc-700/40 px-3.5 py-2 text-sm font-medium text-zinc-200 transition-all hover:bg-zinc-800 hover:text-white hover:border-zinc-600">
                {skill.name}
              </span>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
